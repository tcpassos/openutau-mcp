<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>0.2.0</Version>
    <Authors>openutau-mcp</Authors>
    <!-- Installed OpenUtau (the bridge compiles against its OpenUtau.Core.dll). -->
    <OpenUtauDir Condition="'$(OpenUtauDir)' == ''">C:\Program Files\OpenUtau</OpenUtauDir>
    <OpenUtauPluginsDir Condition="'$(OpenUtauPluginsDir)' == ''">$(USERPROFILE)\Documents\OpenUtau\Plugins</OpenUtauPluginsDir>
  </PropertyGroup>
</Project>
